@misc{choTransformerExplainerLearning2024,
	title = {Transformer {Explainer}: {Learning} {LLM} {Transformers} with {Interactive} {Visual} {Explanation} and {Experimentation}},
	url = {https://arxiv.org/abs/2408.04619},
	abstract = {The Transformer architecture underpins modern large language models powering state-of-the-art text generation and AI applications. However, its complexity makes it difficult for non-experts to learn. Existing resources often lack interactivity, rely on static descriptions of simplified architectures, or fail to reflect models' behavior with real data. To address this gap, we introduce Transformer Explainer, an interactive visualization tool for non-experts to learn Transformers. The tool integrates an overview illustrating the Transformer's data flow with on-demand explanations that gradually reveal mathematical details. Smooth transitions across abstraction levels highlight the interplay between high-level structures and low-level operations. Running a live GPT-2 instance directly in the browser, Transformer Explainer empowers learners to experiment with custom input and hyperparameters without setup, observing next-token predictions in real time. A 90-participant user study showed that our tool offered significant advantages in improving user understanding and engagement. Transformer Explainer has attracted over 490,000 users.},
	author = {Cho, Aeree and Kim, Grace C. and Karpekov, Alexander and Lee, Seongmin and Helbling, Alec and Hoover, Benjamin and Wang, Zijie J. and Kahng, Minsuk and Chau, Duen Horng},
	month = aug,
	year = {2024},
	note = {arXiv:2408.04619},
	keywords = {mech-uncertainty, view-r0},
	file = {arxiv_2408.04619.pdf:/Users/mticonao/Zotero/storage/RSINX7IH/arxiv_2408.04619.pdf:application/pdf},
}

@misc{komanduriMeasuringMechanisticUncertainty2026,
	title = {Measuring {Mechanistic} {Uncertainty} in {Large} {Language} {Models} via {Causal} {Robustness}},
	url = {https://arxiv.org/abs/2610.22636},
	abstract = {Large language models (LLMs) are increasingly used in critical domains, where their susceptibility to hallucinations makes reliable and interpretable uncertainty quantification essential. We introduce the concept of mechanistic uncertainty, which characterizes uncertainty through the stability of the internal mechanisms supporting a model's response. We propose the causal robustness margin, defined as the minimum internal intervention required to deviate the model's output, and operationalize it using Jacobian Lens (Jlens) concept steering vectors. Across three open-source models and five question-answering datasets, we show incorrect and uncertain responses exhibit smaller margins, indicating greater sensitivity to internal interventions, and the causal robustness margin complements conventional output-based uncertainty methods. Finally, in a controlled knowledge injection experiment, correctly learned facts show increased margins after training, suggesting that causal robustness provides a mechanistically grounded signal of uncertainty.},
	author = {Komanduri, Aneesh and Afshar, Majid and Miller, Timothy A. and Gao, Yanjun},
	month = oct,
	year = {2026},
	note = {arXiv:2610.22636},
	keywords = {core-paper, mech-uncertainty},
	file = {arxiv_2610.22636.pdf:/Users/mticonao/Zotero/storage/29MXPA2G/arxiv_2610.22636.pdf:application/pdf},
}

